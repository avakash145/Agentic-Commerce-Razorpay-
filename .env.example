# Razorpay Test Mode credentials (never commit real values)
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_key_secret
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret

# PostgreSQL database with the catalog tables and pgvector extension
DATABASE_URL=postgresql+psycopg2://user:password@host:5432/agentic_commerce

# Optional hosted Ollama model for structured intent extraction.
# If omitted, the app uses its conservative local parser.
OLLAMA_API_KEY=
OLLAMA_MODEL=gpt-oss:120b

# Optional: cpu (default) or cuda
EMBEDDING_DEVICE=cpu
PORT=8000
EMBEDDING_BACKEND=open_clip
MULTIMODAL_EMBEDDING_MODEL=ViT-B-16
OPENCLIP_PRETRAINED=openai
# Set this when model weights are available locally and network access is unavailable.
# OPENCLIP_CHECKPOINT=/absolute/path/to/open_clip_model.safetensors
EMBEDDING_IMAGE_LIMIT=4
EMBEDDING_IMAGE_TIMEOUT=12
EMBEDDING_MAX_IMAGE_BYTES=8000000
EMBEDDING_BATCH_SIZE=16
